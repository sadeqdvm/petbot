# WhatsApp Cloud API
ACCESS_TOKEN=your_meta_access_token
PHONE_NUMBER_ID=your_whatsapp_phone_number_id
VERIFY_TOKEN=your_webhook_verify_token

# Supabase
# Your hosting provider may already expose NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only Supabase key used by api/webhook.js to write through RLS.
# Never expose this key in browser/client code and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Seconds before an abandoned inbound message processing claim can be retried.
INBOUND_PROCESSING_STALE_SECONDS=300
