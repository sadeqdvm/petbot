# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/petbot?retryWrites=true&w=majority

# Secure dashboard session. Use at least 32 random characters.
SESSION_SECRET=replace-with-a-strong-32-character-secret
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Clinic Admin

# Meta WhatsApp Cloud API (not Twilio/ManyChat)
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=choose-a-webhook-verify-token
WHATSAPP_GRAPH_VERSION=v20.0
VET_WHATSAPP_NUMBER=8801721417598

# Clinic/payment settings used by the bot
CONSULTATION_FEE=100
CURRENCY=BDT
PAYMENT_NUMBER=01721417598

# Pusher realtime. If omitted, dashboard still polls every 10s.
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=
